#
# Antes de cada versao gravada pelo git, confere que nenhuma fonte vai junto (ver
# scripts/protege_fontes.py), que o glossario e o que os documentos definem (ver
# scripts/glossario.py), que a lista dos trechos de IA e a que as marcas de IA dao (ver
# scripts/trechos_de_ia.py) e que cada documento esta no indice uma vez so (ver
# scripts/confere_indice.py). O git roda este arquivo na pasta principal do projeto.

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi
"$PYTHON" scripts/protege_fontes.py --versao || exit 1
"$PYTHON" scripts/glossario.py --conferir || exit 1
"$PYTHON" scripts/trechos_de_ia.py --conferir || exit 1
exec "$PYTHON" scripts/confere_indice.py
