{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fontes.schema.json",
  "type": "object",
  "required": ["versao_schema", "et_al", "fontes"],
  "additionalProperties": true,
  "properties": {
    "versao_schema": { "const": 1 },
    "et_al": { "type": "boolean" },
    "fontes": { "type": "array", "items": { "$ref": "#/$defs/fonte" } }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "participacao": { "type": "string", "pattern": "^[a-z]+\\.$" },
    "com_mes": { "type": "string", "pattern": "^\\d{4}-\\d{2}" },
    "autores": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/autor" } },
    "autor": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [ { "required": ["entidade"] }, { "required": ["sobrenome"] } ],
      "properties": {
        "entidade": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/texto" } },
        "qualificador": { "$ref": "#/$defs/texto" },
        "sobrenome": { "$ref": "#/$defs/texto" },
        "prenomes": { "$ref": "#/$defs/texto" }
      }
    },
    "obra": {
      "type": "object",
      "additionalProperties": true,
      "required": ["titulo", "data"],
      "properties": {
        "autores": { "$ref": "#/$defs/autores" },
        "participacao": { "$ref": "#/$defs/participacao" },
        "titulo": { "$ref": "#/$defs/texto" },
        "subtitulo": { "$ref": "#/$defs/texto" },
        "edicao": { "$ref": "#/$defs/texto" },
        "local": { "$ref": "#/$defs/texto" },
        "editora": { "$ref": "#/$defs/texto" },
        "data": { "$ref": "#/$defs/texto" }
      }
    },
    "fonte": {
      "type": "object",
      "additionalProperties": true,
      "required": ["chave", "tipo"],
      "properties": {
        "chave": { "type": "string", "pattern": "^\\S+$" },
        "tipo": { "enum": ["monografia", "parte", "artigo", "outro"] },
        "idioma": { "type": "string", "minLength": 2 },
        "autores": { "$ref": "#/$defs/autores" },
        "participacao": { "$ref": "#/$defs/participacao" },
        "titulo": { "$ref": "#/$defs/texto" },
        "subtitulo": { "$ref": "#/$defs/texto" },
        "edicao": { "$ref": "#/$defs/texto" },
        "local": { "$ref": "#/$defs/texto" },
        "editora": { "$ref": "#/$defs/texto" },
        "data": { "$ref": "#/$defs/texto" },
        "descricao_fisica": { "$ref": "#/$defs/texto" },
        "serie": { "$ref": "#/$defs/texto" },
        "notas": { "type": "array", "items": { "$ref": "#/$defs/texto" } },
        "isbn": { "$ref": "#/$defs/texto" },
        "doi": { "$ref": "#/$defs/texto" },
        "url": { "$ref": "#/$defs/texto" },
        "acesso": { "$ref": "#/$defs/texto" },
        "paginas": { "$ref": "#/$defs/texto" },
        "parte_de": { "$ref": "#/$defs/obra" },
        "periodico": { "$ref": "#/$defs/texto" },
        "volume": { "$ref": "#/$defs/texto" },
        "numero": { "$ref": "#/$defs/texto" },
        "referencia": { "$ref": "#/$defs/texto" }
      },
      "allOf": [
        { "if": { "properties": { "tipo": { "const": "monografia" } } }, "then": { "required": ["titulo", "data"] } },
        { "if": { "properties": { "tipo": { "const": "parte" } } }, "then": { "required": ["titulo", "parte_de", "paginas"] } },
        { "if": { "properties": { "tipo": { "const": "artigo" } } }, "then": { "required": ["titulo", "periodico", "data"] } },
        { "if": { "properties": { "tipo": { "const": "outro" } } }, "then": { "required": ["referencia"] } },
        {
          "if": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/com_mes" } } },
          "then": { "required": ["idioma"] }
        },
        {
          "if": {
            "required": ["parte_de"],
            "properties": { "parte_de": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/com_mes" } } } }
          },
          "then": { "required": ["idioma"] }
        }
      ]
    }
  }
}
