{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "divergencias.schema.json",
  "type": "object",
  "required": ["versao_schema", "divergencias"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "divergencias": { "type": "array", "items": { "$ref": "#/$defs/divergencia" } }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "codigo": { "type": "string", "pattern": "^\\S+$" },
    "forma": {
      "type": "object",
      "required": ["diz", "fonte"],
      "additionalProperties": false,
      "properties": {
        "diz": { "$ref": "#/$defs/texto" },
        "fonte": { "$ref": "#/$defs/texto" }
      }
    },
    "divergencia": {
      "type": "object",
      "required": ["fato", "trechos", "ensinada", "outras"],
      "additionalProperties": false,
      "properties": {
        "fato": { "$ref": "#/$defs/texto" },
        "trechos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/codigo" } },
        "ensinada": { "$ref": "#/$defs/forma" },
        "outras": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/forma" } }
      }
    }
  }
}
