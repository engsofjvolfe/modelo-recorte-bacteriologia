{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estragos.schema.json",
  "type": "object",
  "required": ["versao_schema", "estragos"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "estragos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/estrago" } }
  },
  "$defs": {
    "estrago": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "arquivo", "de", "para"],
      "properties": {
        "nome": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "arquivo": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "para": { "type": "string" }
      }
    }
  }
}
