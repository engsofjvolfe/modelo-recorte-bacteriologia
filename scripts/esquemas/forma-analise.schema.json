{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forma-analise.schema.json",
  "type": "object",
  "required": [
    "versao_schema", "arquivos", "prefixo_arquivo", "prefixo_titulo", "prefixo_slide", "marca_item",
    "separador_texto", "separador_campos", "vazio", "nota_sem_campos", "campos"
  ],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "arquivos": { "type": "string", "minLength": 1 },
    "prefixo_arquivo": { "type": "string" },
    "prefixo_titulo": { "type": "string", "minLength": 1 },
    "prefixo_slide": { "type": "string", "minLength": 1 },
    "marca_item": { "type": "string", "minLength": 1 },
    "separador_texto": { "type": "string", "minLength": 1 },
    "separador_campos": { "type": "string", "minLength": 1 },
    "vazio": { "type": "string", "minLength": 1 },
    "nota_sem_campos": { "type": "string", "minLength": 1 },
    "campos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/campo" } }
  },
  "$defs": {
    "textos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "campo": {
      "type": "object",
      "required": ["nome", "forma"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "forma": { "enum": ["lista", "presenca", "texto"] },
        "separadores": { "$ref": "#/$defs/textos" },
        "valores": { "$ref": "#/$defs/textos" },
        "papel": { "enum": ["tipo", "grupo", "caminho", "destino"] }
      },
      "allOf": [
        { "if": { "properties": { "forma": { "const": "lista" } } }, "then": { "required": ["separadores"] } },
        { "if": { "properties": { "forma": { "const": "presenca" } } }, "then": { "required": ["valores"] } }
      ]
    }
  }
}
