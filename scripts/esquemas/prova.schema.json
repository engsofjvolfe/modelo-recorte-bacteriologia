{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prova.schema.json",
  "type": "object",
  "required": ["versao_schema", "provas"],
  "additionalProperties": true,
  "properties": {
    "versao_schema": { "const": 1 },
    "provas": { "type": "array", "items": { "$ref": "#/$defs/prova" } }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "prova": {
      "type": "object",
      "required": ["pergunta", "trechos", "afirmacao"],
      "additionalProperties": true,
      "properties": {
        "pergunta": { "$ref": "#/$defs/texto" },
        "trechos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/texto" } },
        "afirmacao": { "enum": ["categorica", "possibilidade"] }
      }
    }
  }
}
