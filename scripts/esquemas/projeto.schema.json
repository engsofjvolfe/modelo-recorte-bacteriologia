{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projeto.schema.json",
  "type": "object",
  "required": ["versao_schema", "prefixo_planilhas", "resolucao_imagens", "nome_licenca_conteudo",
               "colunas_ocultas", "coluna_subdecks", "coluna_trechos", "caminhos"],
  "additionalProperties": true,
  "properties": {
    "versao_schema": { "const": 1 },
    "prefixo_planilhas": { "$ref": "#/$defs/texto" },
    "resolucao_imagens": { "type": "integer" },
    "nome_licenca_conteudo": { "$ref": "#/$defs/texto" },
    "colunas_ocultas": { "type": "array", "items": { "$ref": "#/$defs/coluna" } },
    "coluna_subdecks": { "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/coluna" } ] },
    "coluna_trechos": { "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/coluna" } ] },
    "ia": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["abre", "fecha", "fonte"],
          "additionalProperties": false,
          "properties": {
            "abre": { "$ref": "#/$defs/texto" },
            "fecha": { "$ref": "#/$defs/texto" },
            "fonte": { "$ref": "#/$defs/texto" }
          }
        }
      ]
    },
    "caminhos": {
      "type": "object",
      "additionalProperties": true,
      "required": ["formato", "extrator", "extracao", "fontes", "referencias", "indice", "glossario",
                   "licenca_conteudo", "material_base", "fontes_externas", "gerados", "conferencia_imagens", "conferencia_referencias",
                   "analise", "pesquisa", "material_gerado", "baralhos",
                   "bases", "base_externa", "conferencia_trechos", "provas", "conferencia_cartoes", "imagens",
                   "estilo_cartao", "forma_analise", "lugares_lidos", "destinos", "analises_das_aulas",
                   "conferencia_moldes", "listas_de_trabalho", "imagens_cartoes", "baralhos_com_imagens", "chamadas"],
      "properties": {
        "formato": { "$ref": "#/$defs/texto" },
        "forma_analise": { "$ref": "#/$defs/texto" },
        "lugares_lidos": { "$ref": "#/$defs/texto" },
        "destinos": { "$ref": "#/$defs/protegido" },
        "extrator": { "$ref": "#/$defs/texto" },
        "extracao": { "$ref": "#/$defs/texto" },
        "fontes": { "$ref": "#/$defs/texto" },
        "referencias": { "$ref": "#/$defs/texto" },
        "indice": { "$ref": "#/$defs/texto" },
        "glossario": { "$ref": "#/$defs/texto" },
        "licenca_conteudo": { "$ref": "#/$defs/texto" },
        "material_base": { "$ref": "#/$defs/pasta_protegida" },
        "fontes_externas": { "$ref": "#/$defs/protegido" },
        "gerados": { "$ref": "#/$defs/protegido" },
        "conferencia_imagens": { "$ref": "#/$defs/protegido" },
        "conferencia_referencias": { "$ref": "#/$defs/protegido" },
        "analise": { "$ref": "#/$defs/texto" },
        "pesquisa": { "$ref": "#/$defs/protegido" },
        "analises_das_aulas": { "$ref": "#/$defs/protegido" },
        "material_gerado": { "$ref": "#/$defs/texto" },
        "baralhos": { "$ref": "#/$defs/texto" },
        "bases": { "$ref": "#/$defs/modelo_por_item" },
        "base_externa": { "allOf": [ { "$ref": "#/$defs/protegido" }, { "$ref": "#/$defs/modelo_por_item" } ] },
        "conferencia_trechos": { "$ref": "#/$defs/protegido" },
        "provas": { "allOf": [ { "$ref": "#/$defs/protegido" }, { "type": "string", "pattern": "\\{planilha\\}" } ] },
        "conferencia_cartoes": { "$ref": "#/$defs/protegido" },
        "conferencia_moldes": { "$ref": "#/$defs/protegido" },
        "listas_de_trabalho": {
          "allOf": [ { "$ref": "#/$defs/protegido" }, { "$ref": "#/$defs/modelo_por_unidade" } ]
        },
        "imagens": { "$ref": "#/$defs/protegido" },
        "estilo_cartao": { "$ref": "#/$defs/texto" },
        "imagens_cartoes": { "$ref": "#/$defs/protegido" },
        "baralhos_com_imagens": { "$ref": "#/$defs/protegido" },
        "chamadas": { "$ref": "#/$defs/texto" },
        "trechos_de_ia": { "$ref": "#/$defs/texto" }
      }
    }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "coluna": { "type": "string", "minLength": 1, "not": { "enum": ["pergunta", "resposta", "fonte"] } },
    "modelo_por_item": { "type": "string", "pattern": "\\{item\\}" },
    "modelo_por_unidade": { "type": "string", "pattern": "\\{unidade\\}" },
    "pasta_protegida": { "const": "docs/material-base" },
    "protegido": { "type": "string", "pattern": "^docs/material-base/" }
  }
}
